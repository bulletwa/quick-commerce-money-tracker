{
  "manifest_version": 3,
  "name": "Zwinkit",
  "short_name": "Zwinkit",
  "version": "1.0.0",
  "description": "See what you spend on food delivery and quick-commerce groceries. Set budgets and goals. Your data never leaves your browser.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://www.zomato.com/*",
    "https://www.swiggy.com/*",
    "https://instamart.in/*",
    "https://blinkit.com/*",
    "https://www.zepto.com/*",
    "https://bff-gateway.zepto.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Zwinkit" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
